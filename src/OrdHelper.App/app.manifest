<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- 모니터마다 배율이 달라도 마우스 훅 좌표(물리 픽셀)와 창 좌표가 맞도록 -->
